<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>{{ titre }} — CRIMIWORLD</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
  <a href="/"><img src="images/banniere.jpg" alt="CRIMIWORLD" class="logo-img"></a>
</header>

  <main class="fiche">
    <div class="fiche-entete">
      {% if image %}<img src="{{ image }}" alt="{{ titre }}" class="fiche-photo">{% endif %}
      <div>
        <h1>{{ titre }}</h1>
        <p class="fiche-meta">
          {{ categorie }} · {{ pays }} · {{ statut }}
        </p>
      </div>
    </div>

    <div class="fiche-contenu">
      {{ content | safe }}
    </div>
  </main>
</body>
</html>
