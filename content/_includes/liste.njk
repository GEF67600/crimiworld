<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>{{ titre }} — CRIMIWORLD</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>
  <header class="site-header">
    <a href="{{ '/' | url }}"><img src="{{ '/images/banniere.jpg' | url }}" alt="CRIMIWORLD" class="logo-img"></a>
    <nav class="menu">
      <a href="{{ '/Tueurs/' | url }}">Tueurs</a>
      <a href="{{ '/Mafieux/' | url }}">Mafieux</a>
      <a href="{{ '/Escrocs/' | url }}">Escrocs</a>
      <a href="{{ '/Pedophiles/' | url }}">Pédophiles</a>
      <a href="{{ '/Terroristes/' | url }}">Terroristes</a>
    </nav>
    <div id="search"></div>
    <link href="{{ '/pagefind/pagefind-ui.css' | url }}" rel="stylesheet">
    <script src="{{ '/pagefind/pagefind-ui.js' | url }}"></script>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        new PagefindUI({
          element: "#search",
          showSubResults: true,
          translations: { placeholder: "Rechercher" }
        });
      });
    </script>
  </header>

  <main class="fiche">
    {% set fiches = collections[collectionKey] %}
    <h1>{{ titre }}</h1>
    <ul class="liste-fiches">
      {% for fiche in fiches %}
      <li>
        <a href="{{ fiche.url | url }}">
          {% if fiche.data.image %}<img src="{{ fiche.data.image | url }}" alt="" class="miniature">{% endif %}
          <span>{{ fiche.data.titre }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </main>
  <footer class="site-footer">
    <p>CRIMIWORLD INC © Georges Edouard FREY - Alsace 2026 - Tous droits réservés ®</p>
  </footer>
</body>
</html>